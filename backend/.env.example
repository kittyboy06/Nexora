# Application Configuration
APP_NAME=NEXORA
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_INFERENCE_TIMEOUT_SECONDS=120.0

# GPU & Concurrency Protection
INFERENCE_CONCURRENCY_LIMIT=1
INFERENCE_SEMAPHORE_TIMEOUT_SECONDS=5.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=../data/logs/nexora_backend.log
