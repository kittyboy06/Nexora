<Window
    x:Class="Nexora.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NEXORA Desktop Control Plane"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainRootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <FontIcon Glyph="&#xE7E8;" Foreground="White" FontSize="18" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEXORA" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Autonomous Agent Desktop Control Plane" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Navigation View Switcher (Tasks vs Skills) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ShowTasksViewCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7C3;" FontSize="13" />
                            <TextBlock Text="Agent Tasks" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowSkillsViewCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEA86;" FontSize="13" />
                            <TextBlock Text="Skills &amp; Discovery" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowMcpViewCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74C;" FontSize="13" />
                            <TextBlock Text="MCP Platform" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status Pills & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Backend Status Pill -->
                    <Border CornerRadius="12"
                            Padding="10,4"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsBackendOnline, Converter={StaticResource StatusToBrushConverter}}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Reload / Refresh Button -->
                    <Button Command="{Binding RefreshStatusCommand}"
                            ToolTipService.ToolTip="Refresh Status and Model Profiles"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TASK WORKSPACE AREA: 2 Columns -->
        <Grid Grid.Row="1" Padding="20" ColumnSpacing="20"
              Visibility="{Binding IsTasksViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Task Composer & System Status -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Task Composer Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Task Composer" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Instruct Nexora to plan and execute a multi-step workflow."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Prompt Input -->
                            <TextBox Header="Goal / Instruction"
                                     PlaceholderText="e.g. Inspect the project directory and list Python dependencies..."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="110"
                                     Text="{Binding Composer.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Model Profile Selector -->
                            <ComboBox Header="Model Profile (Optional)"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Composer.AvailableProfiles}"
                                      SelectedValue="{Binding Composer.SelectedProfileId, Mode=TwoWay}"
                                      SelectedValuePath="ProfileId"
                                      DisplayMemberPath="ProfileId"
                                      PlaceholderText="Auto (Hybrid Routing)" />

                            <!-- Execution Mode Selector (Phase 6) -->
                            <ComboBox Header="Fleet Mode"
                                      HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding Composer.ExecutionMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Auto (Adaptive Fleet)" Tag="auto" IsSelected="True" />
                                <ComboBoxItem Content="Single Agent Only" Tag="single" />
                                <ComboBoxItem Content="Multi-Agent Fleet" Tag="fleet" />
                            </ComboBox>

                            <!-- Submit Button -->
                            <Button Content="Submit Task"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding Composer.SubmitTaskCommand}"
                                    IsEnabled="{Binding Composer.CanSubmit}" />

                            <!-- Progress Spinner -->
                            <ProgressBar IsIndeterminate="True"
                                         Visibility="{Binding Composer.IsSubmitting, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Submission Error -->
                            <TextBlock Text="{Binding Composer.ErrorMessage}"
                                       Foreground="IndianRed"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Composer.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- System Overview Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Control Plane Health" FontWeight="SemiBold" FontSize="14" />

                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Backend:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ollama Model:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveModel}" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Task Detail & Step Trace -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- Empty State (No task active) -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Visibility="{Binding TaskDetail.HasCurrentTask, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE9F5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Ready for Instructions" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Submit a prompt using the composer on the left to monitor plan generation and live tool execution."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   MaxWidth="360"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Active Task View -->
                    <Grid Visibility="{Binding TaskDetail.HasCurrentTask, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Task Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaskDetail.CurrentTaskId}"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           FontWeight="Bold" />

                                <Border Background="{Binding TaskDetail.CurrentTaskStatus, Converter={StaticResource StatusToBrushConverter}}"
                                        CornerRadius="10"
                                        Padding="10,2">
                                    <TextBlock Text="{Binding TaskDetail.CurrentTaskStatus}"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Cancel Task"
                                    Command="{Binding TaskDetail.CancelTaskCommand}"
                                    IsEnabled="{Binding TaskDetail.CanCancel}" />
                        </Grid>

                        <!-- Prompt Card -->
                        <Border Grid.Row="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Prompt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TaskDetail.CurrentTaskPrompt}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Fleet Progression Stepper (Phase 6 Dynamic Fleet) -->
                        <Border Grid.Row="2"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding TaskDetail.HasFleetNodes, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dynamic Agent Fleet (DAG)"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontWeight="SemiBold" />

                                <ItemsControl ItemsSource="{Binding TaskDetail.FleetNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Role}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12" />
                                                        <Border Background="{Binding State, Converter={StaticResource StatusToBrushConverter}}"
                                                                CornerRadius="4"
                                                                Padding="6,1">
                                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                                       Foreground="White"
                                                                       FontSize="10"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Objective}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               MaxWidth="160"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Routing Diagnostic Card (Phase 4 integration) -->
                        <Expander Grid.Row="3"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,12"
                                  Header="Routing Diagnostic"
                                  Visibility="{Binding TaskDetail.CurrentTaskRouting, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="6" Padding="4">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Profile:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaskDetail.CurrentTaskRouting.ProfileId}" FontSize="12" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Route:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaskDetail.CurrentTaskRouting.SelectedRoute}" FontSize="12" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Reason:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaskDetail.CurrentTaskRouting.Reason}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Plan & Step Trace List -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Execution Steps"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,0,0,8" />

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding TaskDetail.CurrentTaskSteps}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status Icon -->
                                                <Border Grid.Column="0"
                                                        Width="28" Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                        VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                                              FontSize="12"
                                                              Foreground="White" />
                                                </Border>

                                                <!-- Step Details -->
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2">
                                                            <TextBlock Text="{Binding ToolCall.ToolName}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status Text -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- SKILLS & DISCOVERY VIEW (Phase 7) -->
        <Grid Grid.Row="1" Padding="20"
              Visibility="{Binding IsSkillsViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabView HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- TAB 1: INSTALLED SKILLS -->
                <TabViewItem Header="Installed Skills Catalogue">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xEA86;" />
                    </TabViewItem.IconSource>
                    <Grid Padding="0,16,0,0" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: List of Installed Skills -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Installed Skills" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding Skills.LoadInstalledSkillsCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="Refresh" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding Skills.InstalledSkills}"
                                          SelectedItem="{Binding Skills.SelectedSkill, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="12"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Skill Name, Version & Toggle -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                    CornerRadius="4" Padding="4,2">
                                                                <TextBlock Text="{Binding Version}" FontSize="10" />
                                                            </Border>
                                                        </StackPanel>
                                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                                      OnContent="" OffContent="" Margin="8,0,0,0" />
                                                    </Grid>

                                                    <!-- Description -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />

                                                    <!-- Metadata & Actions -->
                                                    <Grid Grid.Row="2" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="Author:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Text="{Binding Author}" FontSize="10" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Inspect" Padding="6,2" FontSize="11"
                                                                Command="{Binding DataContext.Skills.InspectSkillCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Grid.Column="2" Content="Delete" Padding="6,2" FontSize="11"
                                                                Command="{Binding DataContext.Skills.DeleteSkillCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right: Guidance Inspector -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Guidance Inspector" FontWeight="SemiBold" FontSize="15" />

                                <!-- Inspector Meta Header -->
                                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="6" Padding="12"
                                        Visibility="{Binding Skills.InspectedBundle, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Skills.InspectedBundle.Manifest.Name}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding Skills.InspectedBundle.Manifest.Description}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="MediumSeaGreen">
                                            <Run Text="SHA-256 Provenance: " />
                                            <Run Text="{Binding Skills.InspectedBundle.Provenance.SkillSha256}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Markdown Instructions Viewer -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding Skills.MarkdownPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- TAB 2: GITHUB DISCOVERY -->
                <TabViewItem Header="GitHub Discovery">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE721;" />
                    </TabViewItem.IconSource>
                    <Grid Padding="0,16,0,0" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Search & Discovery List -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Search Box -->
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="Search repositories (e.g. docker, flutter, react)..."
                                             Text="{Binding Skills.SearchQuery, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Command="{Binding Skills.SearchGitHubCommand}"
                                            Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE721;" FontSize="11" />
                                            <TextBlock Text="Search" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Rate Limit Status -->
                                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding Skills.StatusMessage}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Results List -->
                                <ListView Grid.Row="2"
                                          ItemsSource="{Binding Skills.DiscoveryCandidates}"
                                          SelectedItem="{Binding Skills.SelectedCandidate, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="12"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Owner}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="/" FontSize="12" />
                                                            <TextBlock Text="{Binding Repo}" FontWeight="Bold" FontSize="12" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE734;" FontSize="11" Foreground="Goldenrod" />
                                                            <TextBlock Text="{Binding Stars}" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                        <Button Content="Preview" Padding="8,3" FontSize="11"
                                                                Command="{Binding DataContext.Skills.PreviewCandidateCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Install" Padding="8,3" FontSize="11"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Command="{Binding DataContext.Skills.InstallCandidateCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right: Candidate Preview -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Candidate Security &amp; Manifest Preview" FontWeight="SemiBold" FontSize="15" />
                                    <Button Grid.Column="1" Content="Install to Catalogue"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Command="{Binding Skills.InstallCandidateCommand}"
                                            CommandParameter="{Binding Skills.SelectedCandidate}"
                                            Visibility="{Binding Skills.SelectedCandidate, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>

                                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="6" Padding="12"
                                        Visibility="{Binding Skills.SelectedCandidate, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Skills.SelectedCandidate.HtmlUrl}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Skills.SelectedCandidate.Description}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding Skills.MarkdownPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <!-- MCP PLATFORM VIEW AREA -->
        <Grid Grid.Row="1" Padding="20"
              Visibility="{Binding IsMcpViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabView HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- TAB 1: SERVER FLEET & CAPABILITIES -->
                <TabViewItem Header="MCP Servers &amp; Capabilities">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE74C;" />
                    </TabViewItem.IconSource>
                    <Grid Padding="0,16,0,0" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Server Inventory + Add Form -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Registered MCP Servers" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding Mcp.LoadServersCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="Refresh" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Server Cards List -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding Mcp.Servers}"
                                          SelectedItem="{Binding Mcp.SelectedServer, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="12"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Server Name, ID & Status -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Config.Name}" FontWeight="Bold" FontSize="13" />
                                                            <TextBlock Text="{Binding Config.Id}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Command -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="Cmd:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{Binding Config.Command}" FontSize="11" FontFamily="Consolas" />
                                                    </StackPanel>

                                                    <!-- Quick Action Buttons -->
                                                    <Grid Grid.Row="2" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0" Content="Approve"
                                                                Command="{Binding DataContext.Mcp.ApproveServerCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding Config.Id}"
                                                                Padding="8,2" FontSize="11" />

                                                        <Button Grid.Column="1" Content="Connect"
                                                                Command="{Binding DataContext.Mcp.ConnectServerCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding Config.Id}"
                                                                Padding="8,2" FontSize="11" />

                                                        <Button Grid.Column="2" Content="Disconnect"
                                                                Command="{Binding DataContext.Mcp.DisconnectServerCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding Config.Id}"
                                                                Padding="8,2" FontSize="11" />

                                                        <Button Grid.Column="4" Content="Delete"
                                                                Command="{Binding DataContext.Mcp.DeleteServerCommand, ElementName=MainRootGrid}"
                                                                CommandParameter="{Binding Config.Id}"
                                                                Padding="8,2" FontSize="11" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Add Server Expander -->
                                <Expander Grid.Row="2" Header="Add MCP Server" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Padding="8">
                                        <TextBox Text="{Binding Mcp.NewServerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Server ID (slug)" PlaceholderText="e.g. filesystem" />
                                        <TextBox Text="{Binding Mcp.NewServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Display Name" PlaceholderText="e.g. Local Filesystem" />
                                        <TextBox Text="{Binding Mcp.NewServerCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Executable Command" PlaceholderText="e.g. npx or python" />
                                        <TextBox Text="{Binding Mcp.NewServerArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Arguments (space-separated)" PlaceholderText="e.g. -y @modelcontextprotocol/server-filesystem" />
                                        <TextBox Text="{Binding Mcp.NewServerEnv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Header="Environment (KEY=ref:vault/KEY or KEY=VAL)" AcceptsReturn="True" Height="60" />
                                        <Button Content="Register Server"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Command="{Binding Mcp.RegisterServerCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </Border>

                        <!-- Right Column: Capability Inspector & Tool Viewer -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Active Server Header & Controls -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Mcp.SelectedServer.Config.Name, FallbackValue='Select an MCP Server'}"
                                                   FontWeight="Bold" FontSize="16" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Mcp.SelectedServer.Status, FallbackValue='None'}"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Mcp.PingLatencyText}"
                                                       FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ping"
                                            Command="{Binding Mcp.PingServerCommand}"
                                            CommandParameter="{Binding Mcp.SelectedServer.Config.Id}"
                                            Padding="10,4" />
                                </Grid>

                                <!-- Capabilities Label -->
                                <TextBlock Grid.Row="1" Text="Advertised Tools &amp; Schemas"
                                           FontWeight="SemiBold" FontSize="13" />

                                <!-- Tools ListView -->
                                <ListView Grid.Row="2"
                                          ItemsSource="{Binding Mcp.AdvertisedTools}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="12"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   FontFamily="Consolas" FontWeight="Bold" FontSize="13" />
                                                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding RiskLevel}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- TAB 2: ENCRYPTED SECRETS VAULT -->
                <TabViewItem Header="Encrypted Secrets Vault">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8D7;" />
                    </TabViewItem.IconSource>
                    <Grid Padding="0,16,0,0" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Add Secret Form -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Store Encrypted Secret" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Secrets are encrypted at rest with PBKDF2/Fernet bound to this machine. Plaintext is never emitted in UI or LLM prompts."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBox Text="{Binding Mcp.NewSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="Secret Key Identifier" PlaceholderText="e.g. GITHUB_TOKEN or BRAVE_API_KEY" />
                                <TextBox Text="{Binding Mcp.NewSecretValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="Secret Plaintext Value" PlaceholderText="Paste token / key value" />
                                <TextBox Text="{Binding Mcp.NewSecretDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Header="Description (optional)" PlaceholderText="e.g. Read-only repo access token" />

                                <Button Content="Encrypt and Save to Vault"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{Binding Mcp.SaveSecretCommand}"
                                        HorizontalAlignment="Stretch" />

                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10">
                                    <TextBlock Text="Usage in Server Configuration:&#x0a;Set environment variable value to 'ref:vault/&lt;KEY&gt;'. Nexora resolves secrets in-memory inside the child process."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Vault Inventory -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stored Vault Keys" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding Mcp.LoadVaultSecretsCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="Refresh" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding Mcp.VaultSecrets}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="12"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="[Encrypted]" FontSize="10" FontWeight="SemiBold" Foreground="LimeGreen" />
                                                    </Border>

                                                    <Button Grid.Column="2" Content="Delete"
                                                            Command="{Binding DataContext.Mcp.DeleteSecretCommand, ElementName=MainRootGrid}"
                                                            CommandParameter="{Binding Key}"
                                                            Padding="8,4" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Grid>

        <!-- APPROVAL MODAL OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#88000000"
              Visibility="{Binding ApprovalDialog.Approval, Converter={StaticResource NullToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="500"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="Goldenrod" CornerRadius="8" Width="36" Height="36">
                            <FontIcon Glyph="&#xE7BA;" Foreground="White" FontSize="18" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Action Approval Required" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="Authoritative policy requires confirmation for dangerous tools"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Details Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tool Name:" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ApprovalDialog.Approval.ToolName}" FontFamily="Consolas" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Error message if any -->
                    <TextBlock Text="{Binding ApprovalDialog.ErrorMessage}"
                               Foreground="IndianRed"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="{Binding ApprovalDialog.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                    <!-- Action Buttons -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Reject"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApprovalDialog.RejectCommand}"
                                IsEnabled="{Binding ApprovalDialog.IsDeciding, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <Button Grid.Column="1"
                                Content="Approve (Execute)"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApprovalDialog.ApproveCommand}"
                                IsEnabled="{Binding ApprovalDialog.IsDeciding, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
