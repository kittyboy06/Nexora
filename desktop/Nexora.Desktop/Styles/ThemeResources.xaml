    <FontFamily x:Key="FontFamilyCode">Cascadia Mono, Consolas</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ContainerCornerRadius">8</CornerRadius>

